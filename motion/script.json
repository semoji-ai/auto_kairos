[
 {
  "type": "seg",
  "id": "h1a",
  "pre": 0.3,
  "text": "졸업식 날,"
 },
 {
  "type": "seg",
  "id": "h1b",
  "pre": 0.25,
  "text": "이삿날,"
 },
 {
  "type": "seg",
  "id": "h1c",
  "pre": 0.25,
  "text": "그리고 비 오는 날."
 },
 {
  "type": "seg",
  "id": "h2",
  "pre": 0.3,
  "text": "우리가 떠올리는 음식, 바로 짜장면이죠."
 },
 {
  "type": "seg",
  "id": "h3",
  "pre": 0.35,
  "text": "그런데 이 짜장면, 처음엔 누가 먹던 음식이었을까요?",
  "post": 0.45
 },
 {
  "type": "block",
  "id": "sting",
  "dur": 1.7
 },
 {
  "type": "block",
  "id": "card1",
  "dur": 1.6
 },
 {
  "type": "seg",
  "id": "c1a",
  "pre": 0.25,
  "text": "1883년 인천항이 문을 열자, 바다 건너 산둥에서 중국인 상인과 노동자들이 몰려왔습니다."
 },
 {
  "type": "seg",
  "id": "c1b",
  "pre": 0.35,
  "text": "이들이 즐겨 먹던 음식으로 알려진 것이, 볶은 장에 국수를 비빈 '작장면'인데요.",
  "post": 0.35
 },
 {
  "type": "block",
  "id": "card2",
  "dur": 1.6
 },
 {
  "type": "seg",
  "id": "c2a",
  "pre": 0.25,
  "text": "1900년대 초, 산둥 출신 화교 우희광이 이곳에 '산동회관'을 연 것으로 전해집니다."
 },
 {
  "type": "seg",
  "id": "c2b",
  "pre": 0.35,
  "text": "그리고 중국에 공화국이 들어서자, 이를 기념해 이름을 바꾸죠. 바로 '공화춘'입니다.",
  "post": 0.4
 },
 {
  "type": "block",
  "id": "card3",
  "dur": 1.6
 },
 {
  "type": "seg",
  "id": "c3a",
  "pre": 0.25,
  "text": "해방 뒤인 1948년, 화교 왕송산이 춘장을 만들기 시작했고,"
 },
 {
  "type": "seg",
  "id": "c3b",
  "pre": 0.2,
  "text": "여기에 캐러멜을 더한 달콤한 춘장이 나오면서, 지금 우리가 아는 짜장면의 맛이 자리 잡았습니다."
 },
 {
  "type": "seg",
  "id": "c5",
  "pre": 0.4,
  "text": "공화춘은 1980년대 문을 닫았지만, 건물은 지금 '짜장면박물관'이 되어 그 시절을 기억하고 있습니다."
 },
 {
  "type": "seg",
  "id": "c4",
  "pre": 0.9,
  "text": "부두의 한 끼에서 국민 음식으로. 짜장면 한 그릇엔 백 년이 넘는 이야기가 담겨 있습니다.",
  "post": 0.7
 },
 {
  "type": "block",
  "id": "end",
  "dur": 4.2
 }
]