# =============================================================
# 카이로스 자동화 시스템 환경변수 예시
# 이 파일을 .env로 복사하고 실제 값을 입력하세요
# cp .env.example .env
# =============================================================


# ──────────────────────────────────────────────
# API 키 (필수)
# ──────────────────────────────────────────────

# Google Gemini API (팩트체커, 자막 생성, TTS 검증용)
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY_HERE

# ElevenLabs API (나레이터 TTS용)
ELEVENLABS_API_KEY=YOUR_ELEVENLABS_API_KEY_HERE

# OpenAI API (Whisper 자막 동기화용)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE

# FAL API (Qwen 멀티앵글 이미지 생성용)
FAL_API_KEY=YOUR_FAL_API_KEY_HERE

# Serper API (Google 이미지 검색용)
SERPER_API_KEY=YOUR_SERPER_API_KEY_HERE

# Pixabay API (이미지 검색 보조용)
PIXABAY_API_KEY=YOUR_PIXABAY_API_KEY_HERE


# ──────────────────────────────────────────────
# ElevenLabs 상세 설정 (선택)
# ──────────────────────────────────────────────

# 기본 음성 ID (미설정 시 코드 기본값 사용)
# ELEVENLABS_VOICE_ID=YOUR_VOICE_ID_HERE

# 기본 모델 ID (미설정 시 eleven_multilingual_v2 사용)
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# 음성 설정 JSON (선택, 파이프라인에서 덮어씌울 수 있음)
# ELEVENLABS_VOICE_SETTINGS={"stability": 0.5, "similarity_boost": 0.75}


# ──────────────────────────────────────────────
# Supabase (선택 — 클라우드 동기화 시에만 필요)
# ──────────────────────────────────────────────

# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE
# SUPABASE_BUCKET=kairos-assets


# ──────────────────────────────────────────────
# Discord 알림 (선택)
# ──────────────────────────────────────────────

# 파이프라인 진행 알림용 Webhook URL
# KAIROS_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_URL_HERE

# 대화형 봇 (현재 미사용, 코드 보존용)
# KAIROS_DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE
# KAIROS_DISCORD_CHANNEL_ID=YOUR_CHANNEL_ID_HERE


# ──────────────────────────────────────────────
# 이미지 생성 엔진 설정 (선택)
# ──────────────────────────────────────────────

# 기본 이미지 검색 엔진 (serper | pixabay)
# SEARCH_ENGINE=serper


# ──────────────────────────────────────────────
# 웹 대시보드 설정
# ──────────────────────────────────────────────

KAIROS_DASHBOARD_URL=http://localhost:5173
KAIROS_CORS_ORIGINS=http://localhost:5173


# ──────────────────────────────────────────────
# 경로 설정 (선택 — 기본값이 적합하지 않을 때만 설정)
# ──────────────────────────────────────────────

# 워크스페이스 디렉토리 (기본: ~/kairos-workspace 또는 auto_agent 패키지 상위)
# AUTO_AGENT_WORKSPACE=/path/to/workspace

# SQLite DB 파일 경로 (기본: 프로젝트 루트의 auto_agent.db)
# AUTO_AGENT_DB=/path/to/auto_agent.db

# 카이로스 볼트 경로 (기본: ~/Desktop/kairos-vault)
# KAIROS_VAULT_DIR=/path/to/vault

# Node.js 바이너리 경로 (자동 탐색이 실패할 때만 설정)
# NODEJS_BIN_DIR=/path/to/node/bin


# ──────────────────────────────────────────────
# Claude CLI 설정 (선택)
# ──────────────────────────────────────────────

# claude 바이너리 경로 (미설정 시 PATH에서 자동 탐색)
# CLAUDE_CLI=/path/to/claude


# ──────────────────────────────────────────────
# 파이프라인 내부 변수 (런타임 주입 — 직접 설정 불필요)
# 아래 변수들은 파이프라인 실행 시 runner.py가 자동으로 주입합니다
# ──────────────────────────────────────────────

# PROJECT_NAME=my-project-slug
# PROJECT_DIR=/absolute/path/to/project
# PROGRESS_FILE=/path/to/progress.jsonl
