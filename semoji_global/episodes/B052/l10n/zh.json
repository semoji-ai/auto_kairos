  },
  "s1324185482_26": {
   "text": "1. 约翰·彭伯顿"
  },
  "s1324222149_356": {
   "text": "1831年"
  },
  "s1324222149_343": {
   "text": "约翰·斯蒂斯·彭伯顿"
  },
  "s1324222149_305": {
   "text": "然而"
  },
  "s1324222149_276": {
   "text": "塞缪尔·汤姆森"
  },
  "s1324222149_288": {
   "text": "“现代所谓的许多医学，其实是致命的毒药。"
  },
  "s1324222149_287": {
   "text": "于是我转向上帝为造福人类而准备的"
  },
  "s1324222149_286": {
   "text": "天然药物。”"
  },
  "s1324222149_261": {
   "text": "汤姆森疗法……？"
  },
  "s1324222149_259": {
   "text": "1850年"
  },
  "s1324222149_233": {
   "text": "1860年"
  },
  "s1324222149_211": {
   "text": "安·伊丽莎\r克利福德·刘易斯",
   "note": "review 2026-10-26(내용·심의 검토)"
  },
  "s1324222149_207": {
   "text": "查尔斯·奈·彭伯顿",
   "note": "review 2026-10-26(내용·심의 검토)"
  },
  "s1324222149_203": {
   "text": "1861年4月12日"
  },
  "s1324222149_200": {
   "text": "1862年5月"
  },
  "s1324185482_25": {
   "text": "2. 古柯药酒",
   "note": "review 2026-10-26(내용·심의 검토)"
  },
  "s1324222149_180": {
   "text": "1865年4月"
  },
  "s1324222149_128": {
   "text": "然而"
  },
  "s1324222149_113": {
   "text": "1863年"
  },
  "s1324222149_103": {
   "text": "安杰洛·马里亚尼"
  },
  "s1324222149_108": {
   "text": "↙真的含可卡因……",
   "note": "review 2026-10-26(내용·심의 검토)"
  },
  "s1324222149_99": {
   "text": "大\r卖"
  },
  "s1324185482_24": {
   "text": "3. 可口可乐的诞生"
  },
  "s1324222149_45": {
   "text": "1850年代"
  },
  "s1324222149_35": {
   "text": "1851年"
  },
  "s1324222149_24": {
   "text": "1886年"
  },
  "s1324222149_9": {
   "text": "无酒精"
  },
  "s1324222149_11": {
   "text": "唔……"
  },
  "s1324222149_7": {
   "text": "1886年5月8日"
  },
  "s1324185482_574": {
   "text": "弗兰克·罗宾逊"
  },
  "s1324185482_553": {
   "text": "<斯宾塞体>"
  },
  "s1324185482_537": {
   "text": "然而"
  },
  "s1324185482_511": {
   "text": "1888年8月16日"
  },
  "s1324185482_496": {
   "text": "嗯……"
  },
  "s1324185482_495": {
   "text": "阿萨·坎德勒"
  },
  "s1324185482_493": {
   "text": "1891年",
   "note": "review 2026-10-26(내용·심의 검토)"
  },
  "s1324185482_23": {
   "text": "4. 装瓶系统"
  },
  "s1324185482_394": {
   "text": "1894年"
  },
  "s1324185482_22": {
   "text": "5. 弧形瓶"
  },
  "s1324185482_343": {
   "text": "查尔斯·哈钦森"
  },
  "s1324185482_337": {
   "text": "钢丝弹簧"
  },
  "s1324185482_332": {
   "text": "然而"
  },
  "s1324185482_305": {
   "text": "1915年"
  },
  "s1324185482_287": {
   "text": "亚历山大·塞缪尔森"
  },
  "s1324185482_283": {
   "text": "厄尔·迪恩"
  },
  "s1324185482_228": {
   "text": "“弧形瓶是最美丽、\r最具表现力的工业设计\r永恒杰作！”"
  },
  "s1324185482_21": {
   "text": "6. 可口可乐配方"
  },
  "s1324185482_208": {
   "text": "？"
  },
  "s1324185482_209": {
   "text": "？"
  },
  "s1324185482_191": {
   "text": "得减量！"
  },
  "s1324185482_135": {
   "text": "查尔斯·霍华德·坎德勒"
  },
  "s1324185482_133": {
   "text": "1919年"
  },
  "s1324185482_118": {
   "text": "欧内斯特·伍德拉夫"
  },
  "s1324185482_116": {
   "text": "然而"
  },
  "s1324185482_85": {
   "text": "2011年"
  },
  "s1324185482_80": {
   "text": "嘘～！"
  },
  "s1324185482_36": {
   "text": "味道变了！"
  }
 },
