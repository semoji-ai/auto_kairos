  },
  "s290432406_237": {
   "text": "芝加哥"
  },
  "s290432406_226": {
   "text": "我是华特·迪士尼"
  },
  "s290432406_218": {
   "text": "$"
  },
  "s290432406_206": {
   "text": "直到有一天"
  },
  "s290432406_188": {
   "text": "真的非做不可！"
