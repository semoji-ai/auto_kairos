  "1324249535#2": {
   "text": "配上高级芝士面包",
   "font": "gothic",
   "two_tone": false,
   "ko": "고품격 치즈번으로"
  },
  "1324249535#3": {
   "text": "更加特别！",
   "font": "gothic",
   "two_tone": false,
   "ko": "더 특별해지다!"
  },
  "1324249535#4": {
   "text": "四重芝士X",
   "font": "gothic",
   "two_tone": false,
   "ko": "더콰트로치즈X"
  },
  "1324249535#5": {
   "text": "四重芝士",
   "font": "gothic",
   "two_tone": false,
   "ko": "더콰트로치즈"
  },
  "1324249628#0": {
   "text": "鲜虾的骄傲",
   "font": "gothic",
   "two_tone": false,
   "ko": "새우의 자존심을 세우다"
  },
  "1324249628#1": {
   "text": "纯牛肉饼上加饱满整虾，再配香辣酱汁",
   "font": "gothic",
   "two_tone": false,
   "ko": "순 쇠고기 패티 위에 통통한 통새우, 매콤한 소스까지"
  },
  "1324249628#2": {
   "text": "整虾皇堡",
   "font": "gothic",
   "two_tone": false,
   "ko": "통새우와퍼"
  },
  "1324249628#3": {
   "text": "•本产品含虾（甲壳类）原料",
   "font": "gothic",
   "two_tone": false,
   "ko": "•이에뉴는 새우(갑각류)를 원재료로 포함하고 있습니다"
  },
  "1324249628#4": {
   "text": "•产品图片仅供参考，以实物为准 •本活动仅限参与门店",
   "font": "gothic",
   "two_tone": false,
   "ko": "•본 제품의 이미지는 시품과 다음 수 있습니다 •본 행사는 행사 매장에 친합니다"
  },
  "1324249629#0": {
   "text": "松露奶油酱与四种蘑菇带来的浓郁美味盛宴",
   "font": "gothic",
   "two_tone": false,
   "ko": "트러플 크림소스와 네가지 머수룸이 선사하는 깊고 풍부한 맛의 향연"
  },
  "1324249629#1": {
   "text": "四重蘑菇",
   "font": "gothic",
   "two_tone": false,
   "ko": "콰트로 머쉬룸"
  },
  "1324249629#2": {
   "text": "皇堡&牛排汉堡",
   "font": "gothic",
   "two_tone": false,
   "ko": "와퍼& 스테이크버거"
  },
  "1324249629#3": {
   "text": "松露四重蘑菇皇堡",
   "font": "gothic",
   "two_tone": false,
   "ko": "트러플콰트로머쉬룸와퍼"
  },
  "1324249629#4": {
   "text": "松露四重蘑菇牛排汉堡",
   "font": "gothic",
   "two_tone": false,
   "ko": "트러플콰트로머쉬룸스테이크버거"
  },
  "1324249630#0": {
   "text": "加Kakao好友，套餐免费升级！",
   "font": "gothic",
   "two_tone": false,
   "ko": "카카오 플러스 친구라면 세트 무료 업그레이드!"
  },
  "1324249630#1": {
   "text": "酥脆喷香",
   "font": "gothic",
   "two_tone": false,
   "ko": "바삭, 고소한"
  },
  "1324249630#2": {
   "text": "薯饼芝士皇堡上市",
   "font": "gothic",
   "two_tone": false,
   "ko": "해쉬치즈와퍼 출시"
  },
  "1324249634#0": {
   "text": "就是这个味！",
   "font": "gothic",
   "two_tone": false,
   "ko": "이맛에 통못자!"
  },
  "1324249634#1": {
   "text": "整块马苏皇堡",
