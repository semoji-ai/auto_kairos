  },
  "s1324246363_100": {
   "text": "1954年"
  },
  "s1324246363_88": {
   "text": "詹姆斯·麦克拉莫尔"
  },
  "s1324246363_64": {
   "text": "然而"
  },
  "s1324246363_27": {
   "text": "1957年"
  },
  "s1324246363_23": {
   "text": "做吧！"
  },
  "s1324185482_422": {
   "text": "1958年"
  },
