   "text": "唐纳德·史密斯"
  },
  "s1324185482_104": {
   "text": "1980年"
  },
  "s1324185482_100": {
   "text": "发生了很多事……"
  },
  "s1324185482_47": {
   "text": "然而"
  }
 },
 "raster": {
