  },
  "s1324185482_307": {
   "text": "路易斯·阿雷纳斯-佩雷斯"
  },
  "s1324185482_265": {
   "text": "1967年"
  },
  "s1324185482_11": {
   "text": "3. 挖角麦当劳高管"
  },
  "s1324185482_222": {
   "text": "比利·特罗特"
  },
  "s1324185482_218": {
   "text": "吉米·特罗特"
  },
  "s1324185482_184": {
   "text": "1973年"
  },
