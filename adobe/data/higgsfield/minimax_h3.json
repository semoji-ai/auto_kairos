{
  "display_name": "MiniMax H3",
  "job_type": "minimax_h3",
  "params": [
    {
      "name": "aspect_ratio",
      "type": "string",
      "default": "auto",
      "required": false,
      "enum": [
        "auto",
        "21:9",
        "16:9",
        "4:3",
        "1:1",
        "3:4",
        "9:16"
      ]
    },
    {
      "name": "audio_references",
      "type": "array",
      "default": null,
      "required": false
    },
    {
      "name": "batch_size",
      "type": "integer",
      "default": 1,
      "required": false
    },
    {
      "name": "duration",
      "type": "integer",
      "default": 5,
      "required": false
    },
    {
      "name": "end_image",
      "type": "object|null",
      "default": null,
      "required": false
    },
    {
      "name": "folder_id",
      "type": "string|null",
      "default": null,
      "required": false
    },
    {
      "name": "image_references",
      "type": "array",
      "default": null,
      "required": false
    },
    {
      "name": "prompt",
      "type": "string",
      "default": "",
      "required": false
    },
    {
      "name": "resolution",
      "type": "string",
      "default": "2K",
      "required": false,
      "enum": [
        "2K"
      ]
    },
    {
      "name": "start_image",
      "type": "object|null",
      "default": null,
      "required": false
    },
    {
      "name": "video_references",
      "type": "array",
      "default": null,
      "required": false
    }
  ],
  "rules": [
    {
      "cel": "params.end_image == null || !(params.start_image == null)",
      "message": "end_image requires start_image"
    },
    {
      "cel": "(params.start_image == null && params.end_image == null) || (size(params.image_references) == 0 && size(params.video_references) == 0 && size(params.audio_references) == 0)",
      "message": "start_image/end_image cannot be mixed with reference media"
    },
    {
      "cel": "size(params.audio_references) == 0 || size(params.image_references) > 0 || size(params.video_references) > 0",
      "message": "audio_references require at least one image or video reference"
    }
  ],
  "type": "video"
}
