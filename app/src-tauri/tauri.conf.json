{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Auto Kairos",
  "version": "5.0.0",
  "identifier": "ai.semoji.autokairos",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Auto Kairos",
        "url": "http://127.0.0.1:8777/",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.icns", "icons/icon.png"]
  }
}
