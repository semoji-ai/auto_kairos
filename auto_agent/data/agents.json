{
  "$schema": "./docs/agents-schema.json",
  "version": "3.0",
  "description": "Auto Agent V3 — 에이전트/스킬 분리 구조. 공유 스킬 8개 + 독립 에이전트 7개",
  "subagents": {
    "_comment_team_a": "===== Team A: 리서치팀 =====",
    "research-orchestrator": {
      "description": "deep-research-kit 실행 + 리서치 결과 표준 포맷(research_report.json) 변환",
      "model": "claude-opus-4-6",
      "max_turns": 70,
      "allowed_tools": [
        "Read",
        "Write",
        "Glob",
        "WebSearch",
        "WebFetch",
        "Task"
      ],
      "skill": "deep-research",
      "skills": [
        "shared/research-requirements-semoji"
      ],
      "notes": "글로벌 스킬 ~/.claude/skills/deep-research/ 사용. art_style=semoji일 때 research-requirements-semoji 카테고리별 항목 적용"
    },
    "fact-verifier": {
      "description": "원고 주요 주장 교차 검증",
      "model": "claude-sonnet-4-5-20250929",
      "max_turns": 20,
      "allowed_tools": [
        "Read",
        "Write",
        "WebSearch"
      ],
      "notes": "웹 검색으로 팩트 확인. 독립적 판단이 필요한 에이전트"
    },
    "_comment_team_b": "===== Team B: 원고팀 =====",
    "write-manuscript": {
      "description": "아웃라인 설계 + 에피소드 중심 원고 작성 + 시각화 마커 삽입",
      "model": "claude-opus-4-6",
      "max_turns": 60,
      "allowed_tools": [
        "Read",
        "Write",
        "Glob"
      ],
      "skills": [
        "shared/outline-template",
        "shared/writing-style",
        "shared/writing-style-iromism",
        "shared/writing-style-semoji",
        "shared/research-requirements-semoji",
        "shared/scene-segmentation"
      ],
      "notes": "Phase 1: outline.json 생성, Phase 2: 원고 작성. art_style에 따라 writing-style-semoji 또는 writing-style-iromism이 writing-style을 오버라이드"
    },
    "_comment_team_c": "===== Team C: 씬 설계팀 (Remotion-First) =====",
    "character-planner": {
      "description": "step_8b 내부에서 호출 — scene_specs.json의 generate 씬 분석 → 2씬+ 등장 캐릭터 추출 + character_plan.json 생성",
      "model": "claude-sonnet-4-5-20250929",
      "max_turns": 20,
      "allowed_tools": [
        "Read",
        "Write",
        "Glob",
        "WebSearch"
      ],
      "notes": "독립 스텝이 아닌 image_asset_sourcing(step_8b) Phase A에서 호출. scene_specs.json에서 generate 씬만 필터링하여 캐릭터 식별."
    },
    "visual-composer": {
      "description": "원고→씬 분할 + Remotion 렌더링 스펙 + 데이터 보강 + 모션 설계 (4-in-1)",
      "model": "claude-opus-4-6",
      "max_turns": 60,
      "allowed_tools": [
        "Read",
        "Write",
        "Glob"
      ],
      "skills": [
        "shared/creative-direction",
        "shared/remotion-design-system",
        "shared/scene-segmentation",
        "shared/motion-rhythm",
        "shared/data-mapping",
        "shared/chart-mapping",
        "shared/asset-advisory"
      ],
      "skill_refs": {
        "creative-direction": [
          "patterns",
          "process",
          "examples-palette"
        ],
        "asset-advisory": [
          "perspectives",
          "cross-review",
          "examples"
        ]
      },
      "notes": "핵심 창작 에이전트. 5단계 순차 실행: (1) 씬 분할→scene_decomposition.json, (2) Creative Direction→scene_specs.json, (2.5) Asset Advisory→차트/아이콘/국기/로고/이미지 추천, (3) 데이터 보강→scene_specs.json 업데이트, (4) 모션 설계→motion_plan.json"
    },
    "image-sourcer": {
      "model": "claude-sonnet-4-5-20250929",
      "max_turns": 30,
      "skills": [
        "shared/asset-advisory",
        "shared/image-prompt-rules"
      ],
      "allowed_tools": [
        "Read",
        "Write",
        "Bash",
        "Glob",
        "WebFetch"
      ],
      "description": "이미지 에셋 소싱 에이전트. 위키미디어 검색 + FAL.ai 생성."
    },
    "tts-verifier": {
      "model": "claude-sonnet-4-5-20250929",
      "max_turns": 20,
      "skills": [],
      "allowed_tools": [
        "Read",
        "Write",
        "Bash",
        "Glob"
      ],
      "description": "TTS 음성 검증 + 재생성 에이전트. Gemini 트랜스크립션 비교."
    }
  },
  "modules": {
    "_comment_infra": "===== 인프라 모듈 =====",
    "preflight": {
      "description": "API키, node, ffmpeg, Remotion, Lucide 의존성 검증",
      "type": "python",
      "requires_llm": false
    },
    "_comment_team_d": "===== Team D: 에셋 생산 + 조립 (프로그래밍/API 모듈) =====",
    "duplicate-checker": {
      "description": "N-gram 기반 원고 중복 감지",
      "type": "python",
      "requires_llm": false
    },
    "tts-preprocess": {
      "description": "한국어 TTS 전처리: 숫자 변환, 된소리화, 발음 교정",
      "type": "python",
      "script": "src/tools/korean_tts_preprocessor.py",
      "requires_llm": false,
      "skills": [
        "shared/korean-tts-rules"
      ],
      "notes": "기존 Python 스크립트가 변환 규칙 대부분 구현. LLM 에이전트 → 모듈로 전환"
    },
    "tts-generator": {
      "description": "씬별 나레이션 음성 생성",
      "type": "skill",
      "api": "elevenlabs",
      "fallback_api": "gemini-tts",
      "requires_llm": false
    },
    "subtitle-sync": {
      "description": "WhisperX forced alignment 기반 단어 레벨 타임스탬프 + 자막 정렬",
      "type": "python",
      "script": "scripts/generate_subtitles.py",
      "api": "whisperx-local",
      "requires_llm": false
    },
    "tts-verifier": {
      "description": "Gemini 하이브리드 TTS 검증 — 발음 오류 자동 감지",
      "type": "python",
      "script": "scripts/verify_tts.py",
      "api": "google-gemini",
      "requires_llm": false,
      "skills": [
        "shared/tts-verification"
      ],
      "notes": "TTS 오디오를 Gemini로 재트랜스크립션하여 원본 나레이션과 비교. 발음 오류/누락 자동 감지"
    },
    "image-generator": {
      "description": "아트스타일 기반 캐릭터/씬/시각화배경 이미지 생성 + 검색",
      "type": "skill",
      "script": "scripts/generate_images.py",
      "character_api": "fal-ai/nano-banana-2/edit",
      "scene_api": "fal-ai/nano-banana-2/edit",
      "generate_api": "fal-ai/nano-banana-2",
      "source_priority": [
        "wikimedia",
        "search",
        "generate"
      ],
      "requires_llm": false,
      "notes": "art_style.json 기반. 캐릭터(2씬+) → 씬 이미지 → 검색 이미지 → 시각화 배경 순서. IP-Adapter 스타일 일관성"
    },
    "data-validator": {
      "description": "전 단계 데이터 정합성 교차 검증",
      "type": "python",
      "requires_llm": false,
      "checks": [
        "scene_specs ↔ audio 파일 매칭",
        "시각화 데이터 완전성 (빈 값 없음)",
        "자막 타이밍 ↔ 오디오 길이 일치",
        "아이콘명이 Lucide에 존재하는지 확인",
        "이미지 에셋 파일 존재 확인"
      ]
    },
    "manifest-builder": {
      "description": "scene_specs + motion_plan → Remotion manifest.json 생성",
      "type": "python",
      "script": "scripts/build_manifest.py",
      "requires_llm": false
    },
    "video-assembler": {
      "description": "Remotion CLI 렌더링",
      "type": "remotion",
      "requires_llm": false,
      "command": "npx remotion render KairosVideo --output final_video.mp4"
    }
  },
  "gateway": {
    "description": "에이전트 감시/복구 — 무한 사고, stuck, 루프 탐지 + 강제 재시작",
    "model": "claude-haiku-4-5-20251001",
    "type": "monitor",
    "polling_interval_sec": 2,
    "detection_patterns": [
      "timeout",
      "repetition",
      "token_explosion",
      "no_progress",
      "error_loop"
    ],
    "recovery_levels": [
      "warning",
      "restart",
      "shrink_restart",
      "skip_notify"
    ],
    "max_restarts_per_agent": 2,
    "notes": "상시 실행. 1차 Python 규칙 → 2차 애매한 케이스만 Haiku 판단 위임. 비용 최소화"
  },
  "qa-reviewer": {
    "description": "최종 결과물 품질 검수 — 씬별 일관성, 데이터 정확도, 시각 품질 검증",
    "model": "claude-sonnet-4-5-20250929",
    "max_turns": 25,
    "allowed_tools": [
      "Read",
      "Write",
      "Glob"
    ],
    "skills": [
      "shared/remotion-design-system",
      "shared/writing-style",
      "shared/creative-direction",
      "shared/scene-segmentation",
      "shared/motion-rhythm",
      "shared/data-mapping"
    ],
    "skill_refs": {
      "creative-direction": [],
      "asset-advisory": []
    },
    "review_targets": [
      "씬 스펙 ↔ 실제 렌더링 일치 검증",
      "아이콘명 유효성 (Lucide 존재 여부)",
      "컬러 규칙 준수 (씬당 2-3색 이내)",
      "나레이션 ↔ 시각 요소 타이밍 동기화",
      "자막 정확도 + 가독성",
      "데이터 시각화 수치 정확도 (research_report 대조)",
      "이미지 에셋 해상도 + 라이선스 확인",
      "전체 영상 흐름/리듬 일관성"
    ],
    "output": "qa_report.json",
    "notes": "렌더링 전후 2회 실행. 공유 스킬 4개를 검증 기준으로 참조"
  },
  "explorer_agent": {
    "description": "deep-research-kit Phase 3에서 병렬 웹 검색 실행",
    "model": "claude-sonnet-4-5-20250929",
    "type": "background_task",
    "max_concurrent": 5,
    "notes": "Research Orchestrator가 background_task()로 배포"
  },
  "librarian_agent": {
    "description": "소스 분류/중복 제거/A-E 품질 등급 평가",
    "model": "claude-sonnet-4-5-20250929",
    "type": "background_task",
    "notes": "Research Orchestrator가 background_task()로 배포"
  },
  "single_call_config": {
    "_comment": "3계층 실행 모델: agent(CLI 멀티턴) → single_call(API 1회) → module(Python)",
    "description": "에이전트 루프 없이 LLM 1회 호출로 완료되는 스텝. 입력 파일을 프롬프트에 주입하고, 출력 JSON을 파싱하여 저장.",
    "current_mode": "cli_fallback",
    "steps": {
      "step_4": {
        "model": "claude-opus-4-6",
        "reason": "원고+리서치 교차검증은 깊은 추론 필요"
      },
      "step_5": {
        "model": "claude-opus-4-6",
        "reason": "원고→씬 분할은 구조적 창작 판단"
      },
      "step_6": {
        "model": "claude-opus-4-6",
        "reason": "Creative Direction은 핵심 창작"
      },
      "step_6b": {
        "model": "claude-opus-4-6",
        "reason": "4관점 심의는 복합 판단 필요"
      },
      "step_6c": {
        "model": "claude-opus-4-6",
        "reason": "데이터 보강+모션 설계는 정밀 작업"
      },
      "step_11b": {
        "model": "claude-opus-4-6",
        "reason": "시각적 QA는 세밀한 검증 필요"
      },
      "step_12b": {
        "model": "claude-sonnet-4-5-20250929",
        "reason": "메타데이터 검증은 구조화된 작업"
      }
    },
    "estimated_savings": {
      "time": "에이전트 대비 ~70% 단축 (도구 루프 제거)",
      "cost": "에이전트 대비 ~50% 절감 (시스템프롬프트+도구정의 재전송 제거)"
    }
  },
  "model_selection_rationale": {
    "_comment": "v3.0 — 에이전트/스킬 분리 후 모델 배정",
    "opus-4-6": {
      "criteria": "창작/전략 판단. 의미→시각 번역, 구조 설계, 스토리텔링",
      "agents": [
        "research-orchestrator",
        "write-manuscript",
        "visual-composer"
      ],
      "count": 3,
      "execution_frequency": "1-2회/파이프라인",
      "notes": "기존 5개(+research-synthesizer, outline-builder)에서 3개로 축소. 규칙 기반 작업은 스킬로 분리"
    },
    "sonnet-4-5": {
      "criteria": "독립적 판단/외부 도구 사용. 웹 검색, 품질 검수, 캐릭터 설계",
      "agents": [
        "fact-verifier",
        "qa-reviewer"
      ],
      "count": 2,
      "execution_frequency": "다회/파이프라인",
      "notes": "기존 6개에서 3개로 축소. scene-decomposer/data-enricher/motion-choreographer/tts-preprocess는 스킬화 → visual-composer 흡수 또는 모듈화"
    },
    "haiku-4-5": {
      "criteria": "감시/판단. 패턴 매칭, 상태 점검, 규칙 기반 판정",
      "agents": [
        "gateway"
      ],
      "count": 1,
      "execution_frequency": "상시 (2초 간격 폴링)"
    },
    "non-llm": {
      "criteria": "결정론적 작업. API 호출, 프로그래밍 로직",
      "modules": [
        "duplicate-checker",
        "tts-preprocess",
        "tts-generator",
        "subtitle-sync",
        "image-generator",
        "data-validator",
        "manifest-builder",
        "video-assembler"
      ],
      "count": 8,
      "notes": "tts-preprocess가 에이전트→모듈로 전환되어 1개 추가"
    }
  },
  "shared_skills": {
    "_comment": "공유 스킬 — 여러 에이전트가 참조하는 업무 매뉴얼",
    "location": "skills/shared/",
    "skills": [
      {
        "name": "remotion-design-system",
        "description": "컬러, 아이콘, 애니메이션, 레이아웃, imageAsset 규칙",
        "referenced_by": [
          "visual-composer",
          "qa-reviewer"
        ]
      },
      {
        "name": "scene-segmentation",
        "description": "씬 분할 규칙 + 과밀 체크 + 이미지/캐릭터 판단",
        "referenced_by": [
          "visual-composer",
          "write-manuscript",
          "qa-reviewer"
        ]
      },
      {
        "name": "creative-direction",
        "description": "씬별 Creative Direction 설계 (reveal, emphasis, mood, headline)",
        "referenced_by": [
          "visual-composer",
          "qa-reviewer"
        ]
      },
      {
        "name": "writing-style",
        "description": "문체, 톤, VIZ/IMG 마커 규칙",
        "referenced_by": [
          "write-manuscript",
          "qa-reviewer"
        ]
      },
      {
        "name": "writing-style-semoji",
        "description": "세모지 586편 분석 기반 — 서사구조·후킹·전환·페이싱 (art_style=semoji일 때 조건부 로드)",
        "referenced_by": [
