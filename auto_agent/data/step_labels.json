{
  "$schema": "step_labels-schema.json",
  "description": "step별 사용자 친화적 라벨, 아이콘, 예상 시간, 결과 추출기 매핑",
  "phases": {
    "phase_0": {"label": "Preflight", "icon": "⚙️", "what": "환경/설정/기획 준비"},
    "stage_1": {"label": "리서치", "icon": "🔍", "what": "사실 수집 + 본문 자료 확보"},
    "stage_2": {"label": "원고 + 연출", "icon": "✏️", "what": "초고 → 정밀 리서치 → 최종 원고 → 씬 분할"},
    "stage_3": {"label": "에셋 조립 + 렌더링", "icon": "🎬", "what": "TTS + 이미지 + 자막 + 영상 렌더링"}
  },
  "steps": {
    "step_0": {
      "label": "환경 검증",
      "icon": "⚙️",
      "what": "API 키, Node, ffmpeg 등 의존성 확인",
      "expected_seconds": 1
    },
    "step_0c": {
      "label": "프로젝트 설정 검증",
      "icon": "🔧",
      "what": "art_style, voice_id 자동 보정",
      "expected_seconds": 30,
      "result_extractor": "config_check"
    },
    "step_0b": {
      "label": "기획안 생성",
      "icon": "📝",
      "what": "5대 DNA 레버 기반 영상 기획",
      "expected_seconds": 70,
      "result_extractor": "editorial_brief"
    },
    "step_0d": {
      "label": "기획안 검토",
      "icon": "🎯",
      "what": "100점 채점 + 자체 재작성 (최대 3라운드)",
      "expected_seconds": 240,
      "result_extractor": "brief_review"
    },
    "step_1a": {
      "label": "골격 작성",
      "icon": "📐",
      "what": "vault wiki/claims → 내러티브 골격 + outline",
      "expected_seconds": 30,
      "result_extractor": "skeleton"
    },
    "step_1_strategy": {
      "label": "리서치 전략",
      "icon": "🧭",
      "what": "쿼리 추천 + 정보 격차 분석",
      "expected_seconds": 60
    },
    "step_1_ingest": {
      "label": "리서치 수집",
      "icon": "🔍",
      "what": "외부 소스에서 사실/주장 수집 → 볼트 적재",
      "expected_seconds": 150,
      "result_extractor": "source_ingest"
    },
    "step_1b": {
      "label": "챕터 사실 매핑",
      "icon": "🔗",
      "what": "vault wiki/claims → chapter_facts/ (claim_ids 포함)",
      "expected_seconds": 30,
      "result_extractor": "chapter_facts"
    },
    "step_1c": {
      "label": "기획안 v2 심화",
      "icon": "📊",
      "what": "Stage 1 결과 반영해 narrative_arc/hidden_truth 구체화",
      "expected_seconds": 120,
      "result_extractor": "brief_deepen_v2"
    },
    "step_2_draft": {
      "label": "초고 작성",
      "icon": "✏️",
      "what": "outline + chapter_facts → draft.md + WHY/HOW 질문",
      "expected_seconds": 240,
      "result_extractor": "draft"
    },
    "step_2_target": {
      "label": "정밀 리서치",
      "icon": "🎯",
      "what": "초고의 미해결 질문에 대한 타겟 웹 리서치",
      "expected_seconds": 180,
      "result_extractor": "targeted_claims"
    },
    "step_2_target_deepen": {
      "label": "기획안 v3 심화",
      "icon": "📊",
      "what": "정밀 리서치 결과 반영",
      "expected_seconds": 120,
      "result_extractor": "brief_deepen_v3"
    },
    "step_2_manuscript": {
      "label": "최종 원고 작성",
      "icon": "📜",
      "what": "draft + targeted_claims → 최종 산문",
      "expected_seconds": 240,
      "result_extractor": "manuscript"
    },
    "step_2": {
      "label": "씬 분할 + 연출",
      "icon": "🎞️",
      "what": "원고 → scene_specs.json (씬별 레이아웃/모션/이미지 prompt)",
      "expected_seconds": 360,
      "result_extractor": "scene_specs"
    },
    "step_2_consistency": {
      "label": "내러티브 흐름 보정",
      "icon": "🔄",
      "what": "씬 간 흐름/연결 일관성 점검",
      "expected_seconds": 90
    },
    "step_2_vault_sync": {
      "label": "볼트 동기화",
      "icon": "💾",
      "what": "원고/씬 결과를 NAS 볼트에 적재",
      "expected_seconds": 30
    },
    "step_2_data": {
      "label": "데이터 매핑",
      "icon": "📊",
      "what": "씬별 items/values/headline 등 구체 데이터 채움",
      "expected_seconds": 180,
      "result_extractor": "scene_data"
    },
    "step_2b": {
      "label": "팩트 체크",
      "icon": "🔬",
      "what": "씬별 사실 검증 (비차단)",
      "expected_seconds": 120,
      "result_extractor": "factcheck"
    },
    "step_3b": {
      "label": "에셋 조립",
      "icon": "🎨",
      "what": "TTS + 이미지 생성/검수 + 자막 + 매니페스트",
      "expected_seconds": 1200,
      "result_extractor": "assembly"
    },
    "step_3c": {
      "label": "업로드 패키지",
      "icon": "🚀",
      "what": "제목 4종 + 더보기란 + 해시태그 + 썸네일 스펙",
      "expected_seconds": 60,
      "result_extractor": "upload_info"
    }
  },
  "failure_patterns": {
    "timeout": {
      "matchers": ["타임아웃", "Timeout", "TimeoutExpired", "timed out"],
      "category": "타임아웃",
      "hint": "Claude CLI 응답 지연 — 네트워크/API 상태 확인 후 재시도"
    },
    "auth": {
      "matchers": ["API_KEY", "Unauthorized", "401", "credit", "quota"],
      "category": "인증/할당량",
      "hint": "API 키 또는 잔여 할당량 확인 (.env)"
    },
    "missing_input": {
      "matchers": ["FileNotFoundError", "없음", "missing", "MISSING"],
      "category": "입력 파일 누락",
      "hint": "이전 단계 산출물 누락 — --from으로 이전 단계부터 재실행"
    },
    "validation_fail": {
      "matchers": ["validation", "검증 실패", "invalid", "schema"],
      "category": "데이터 검증 실패",
      "hint": "산출물 형식 불일치 — 로그에서 어떤 필드 문제인지 확인"
    },
    "json_parse": {
      "matchers": ["JSONDecodeError", "Expecting value", "JSON 파싱"],
      "category": "JSON 파싱 실패",
      "hint": "LLM 응답 형식 오류 — 일시적일 가능성, 즉시 재시도"
    },
    "unknown": {
      "matchers": [],
      "category": "기타 오류",
      "hint": "로그를 확인하고 재시도하거나 이전 단계부터 재실행"
    }
  }
}
