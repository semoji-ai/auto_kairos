{
  "$schema": "./docs/pipeline-schema.json",
  "version": "4.0",
  "description": "Auto Agent V4 — 3단계 파이프라인: 리서치 → 원고+연출 → 에셋+조립",
  "phases": [
    {
      "id": "phase_0",
      "name": "Preflight",
      "description": "환경 검증",
      "execution": "sequential",
      "steps": [
        {
          "id": "step_0",
          "name": "environment_check",
          "description": "API키, node, ffmpeg, Remotion, Lucide 의존성 검증",
          "type": "module",
          "module": "preflight",
          "checks": [
            "ANTHROPIC_API_KEY (optional: Claude Code 구독 시 불필요)",
            "ELEVENLABS_API_KEY",
            "FAL_API_KEY (conditional: source=generate인 씬 있을 때)",
            "SERPER_API_KEY (conditional: source=search인 씬 있을 때)",
            "node >= 18",
            "ffmpeg",
            "remotion CLI",
            "lucide-react installed"
          ]
        }
      ]
    },

    {
      "id": "stage_1",
      "name": "리서치",
      "description": "심층 자료 조사 → research_report.json 생성",
      "execution": "sequential",
      "steps": [
        {
          "id": "step_1",
          "name": "deep_research",
          "description": "deep-research-kit 실행 (탐색만 수행, JSON 변환은 runner가 처리)",
          "agent": "research-orchestrator",
          "input": "topic (사용자 입력)",
          "output": ["RESEARCH/"],
          "resumable": true,
          "skills": ["shared/research-format"],
          "notes": "기존과 동일. Explorer 병렬 배포 → 탐색 완료 → runner가 research_report.json 자동 생성."
        }
      ],
      "checkpoint": {
        "description": "리서치 결과 검토",
        "artifacts": ["research_report.json"]
      }
    },

    {
      "id": "stage_2",
      "name": "원고 + 연출",
      "description": "리서치 기반 원고 작성 + 씬 분할 + 시각 연출 + 모션 설계를 통합 수행",
      "execution": "sequential",
      "steps": [
        {
          "id": "step_2",
          "name": "script_and_direct",
          "description": "원고 작성과 시각 연출을 동시에 수행. 챕터별 병렬 처리 가능.",
          "agent": "script-director",
          "chunked_parallel": {
            "split_by": "chapter",
            "max_parallel": 3,
            "merge_strategy": "concat_scenes_renumber"
          },
          "input": ["research_report.json", "art_style.json", "project_config"],
          "output": ["scene_specs.json"],
          "skills": [
            "shared/writing-style",
            "shared/writing-style-semoji",
            "shared/writing-style-iromism",
            "shared/motion-presets",
            "shared/remotion-design-system"
          ],
          "notes": "기존 step_2(원고) + step_5(씬분할) + step_6(크리에이티브) + step_6c(데이터보강) + step_6d(모션) 통합. scene_specs.json v5 플랫 스키마 출력."
        },
        {
          "id": "step_2b",
          "name": "fact_check",
          "description": "원고 내 주요 주장 교차 검증",
          "agent": "fact-verifier",
          "input": ["scene_specs.json", "research_report.json"],
          "output": ["factcheck_report.json"],
          "blocking": false,
          "notes": "비차단. 실패해도 파이프라인 계속. 결과는 QA 리포트에 반영."
        }
      ],
      "checkpoint": {
        "description": "원고 + 씬 연출 검토",
        "artifacts": ["scene_specs.json"]
      }
    },

    {
      "id": "stage_3",
      "name": "에셋 생성 + 조립",
      "description": "TTS, 이미지, 자막 병렬 생성 → 검증 → 매니페스트 → 렌더링",
      "execution": "parallel_then_sequential",
      "steps": [
        {
          "id": "step_3a",
          "name": "tts_preprocess",
          "description": "한국어 TTS 전처리 (숫자→한국어, 발음 교정)",
          "type": "single_call",
          "model": "claude-sonnet-4-5-20250514",
          "input": ["scene_specs.json"],
          "output": ["scene_specs.json"],
          "skills": ["shared/korean-tts-rules"],
          "group": "parallel_A",
          "notes": "scene_specs.json의 narration 필드만 전처리. --tools '' 필수."
        },
        {
          "id": "step_3b",
          "name": "tts_generation",
          "description": "씬별 나레이션 음성 생성",
          "type": "module",
          "module": "tts_generator",
          "input": ["scene_specs.json"],
          "output": ["audio/scene_{NNN}.mp3"],
          "depends_on": ["step_3a"],
          "group": "parallel_A"
        },
        {
          "id": "step_3c",
          "name": "subtitle_sync",
          "description": "WhisperX 기반 단어 레벨 자막 정렬",
          "type": "module",
          "module": "subtitle_sync",
          "input": ["audio/scene_{NNN}.mp3"],
          "output": ["subtitles/scene_{NNN}.srt"],
          "depends_on": ["step_3b"],
          "group": "parallel_A"
        },
        {
          "id": "step_3d",
          "name": "image_sourcing",
          "description": "이미지 배치 생성/검색 (캐릭터 + 씬 이미지)",
          "type": "module",
          "module": "image_batch_module",
          "input": ["scene_specs.json", "art_style.json"],
          "output": ["images/image_assets.json", "characters/"],
          "group": "parallel_B",
          "notes": "parallel_A와 독립 실행. FAL queue 배치 제출 → 폴링 대기."
        },
        {
          "id": "step_4",
          "name": "data_validation",
          "description": "전 단계 데이터 정합성 검증",
          "type": "module",
          "module": "data_validator",
          "input": ["scene_specs.json", "audio/", "subtitles/", "images/"],
          "output": ["validation_report.json"],
          "depends_on": ["step_3c", "step_3d"],
          "gate": true,
          "notes": "gate=true: 실패 시 파이프라인 중단. scene↔audio 매칭, 아이콘 존재, 이미지 파일 존재 검증."
        },
        {
          "id": "step_5",
          "name": "manifest_build",
          "description": "Remotion 렌더링 매니페스트 생성",
          "type": "module",
          "module": "manifest_builder",
          "input": ["scene_specs.json", "subtitles/", "audio/", "images/"],
          "output": ["remotion/public/manifest.json"],
          "depends_on": ["step_4"],
          "notes": "v5 scene_specs → manifest 변환. motion preset 해석. mapScene 좌표 swap. 전환 효과 자동 결정. durationFrames를 오디오 길이에서 계산."
        },
        {
          "id": "step_5b",
          "name": "qa_pre_render",
          "description": "렌더링 전 매니페스트 검수",
          "type": "single_call",
          "model": "claude-opus-4-6",
          "input": ["remotion/public/manifest.json", "scene_specs.json"],
          "output": ["qa_report_pre.json"],
          "depends_on": ["step_5"],
          "gate": true,
          "notes": "critical 이슈 발견 시 렌더링 차단."
        },
        {
          "id": "step_6",
          "name": "video_render",
          "description": "Remotion CLI로 최종 영상 렌더링",
          "type": "module",
          "module": "video_assembler",
          "input": ["remotion/public/manifest.json"],
          "output": ["{output_video}.mp4"],
          "depends_on": ["step_5b"],
          "notes": "1920x1080, 30fps."
        },
        {
          "id": "step_6b",
          "name": "qa_post_render",
          "description": "렌더링 후 최종 검수",
          "type": "single_call",
          "model": "claude-sonnet-4-5-20250514",
          "input": ["{output_video}.mp4", "scene_specs.json"],
          "output": ["qa_post_render.json"],
          "depends_on": ["step_6"]
        }
      ],
      "checkpoint": {
        "description": "최종 영상 검수",
        "artifacts": ["{output_video}.mp4", "qa_post_render.json"]
      }
    }
  ],

  "summary": {
    "v3_steps": 23,
    "v4_steps": 11,
    "removed": [
      "outline.json (scene_specs에 통합)",
      "scene_decomposition.json (불필요)",
      "motion_plan.json (motion preset으로 대체)",
      "duplicate_check (fact_check에 흡수)",
      "creative_direction (script-director에 통합)",
      "data_enrichment (script-director에 통합)",
      "motion_planning (motion preset으로 대체)",
      "still_capture (비활성이었음)",
      "tts_verification (QA에 통합)"
    ],
    "key_changes": [
      "원고+연출 통합 → script-director 단일 에이전트",
      "scene_specs v5 플랫 스키마 (중첩 제거)",
      "motion preset 시스템 (15종)",
      "중간 산출물 5개 → 1개 (scene_specs.json)",
      "Stage 3 에셋 생성 완전 병렬화"
    ]
  }
}
