{
  "$schema": "./docs/pipeline-schema.json",
  "description": "Auto Agent — 3단계 파이프라인: 리서치 → 원고+연출 → 에셋+조립",
  "phases": [
    {
      "id": "phase_0",
      "name": "Preflight",
      "description": "환경 검증",
      "execution": "sequential",
      "steps": [
        {
          "id": "step_0",
          "name": "environment_check",
          "description": "API키, node, ffmpeg, Remotion, Lucide 의존성 검증",
          "type": "module",
          "module": "preflight",
          "checks": [
            "ANTHROPIC_API_KEY (optional: Claude Code 구독 시 불필요)",
            "ELEVENLABS_API_KEY",
            "FAL_API_KEY (conditional: source=generate인 씬 있을 때)",
            "SERPER_API_KEY (conditional: source=search인 씬 있을 때)",
            "node >= 18",
            "ffmpeg",
            "remotion CLI",
            "lucide-react installed"
          ]
        }
      ]
    },

    {
      "id": "stage_1",
      "name": "리서치",
      "description": "심층 자료 조사 → research_report.json 생성",
      "execution": "sequential",
      "steps": [
        {
          "id": "step_1",
          "name": "deep_research",
          "description": "deep-research-kit 실행 (탐색만 수행, JSON 변환은 runner가 처리)",
          "agent": "research-orchestrator",
          "input": "topic (사용자 입력)",
          "output": ["RESEARCH/"],
          "resumable": true,
          "skills": ["shared/research-format"],
          "notes": "기존과 동일. Explorer 병렬 배포 → 탐색 완료 → runner가 research_report.json 자동 생성."
        }
      ],
      "checkpoint": {
        "description": "리서치 결과 검토",
        "artifacts": ["research_report.json"]
      }
    },

    {
      "id": "stage_2",
      "name": "원고 + 연출",
      "description": "리서치 기반 원고 작성 + 씬 분할 + 시각 연출 + 모션 설계를 통합 수행",
      "execution": "sequential",
      "steps": [
        {
          "id": "step_2",
          "name": "script_and_direct",
          "description": "원고 작성과 시각 연출을 동시에 수행. 챕터별 병렬 처리 가능.",
          "agent": "script-director",
          "chunked_parallel": {
            "split_by": "chapter",
            "max_parallel": 3,
            "merge_strategy": "concat_scenes_renumber"
          },
          "input": ["research_report.json", "art_style.json", "project_config"],
          "output": ["scene_specs.json"],
          "skills": [
            "shared/writing-style",
            "shared/writing-style-semoji",
            "shared/writing-style-iromism",
            "shared/motion-presets",
            "shared/remotion-design-system"
          ],
          "notes": "기존 step_2(원고) + step_5(씬분할) + step_6(크리에이티브) + step_6c(데이터보강) + step_6d(모션) 통합. scene_specs.json v5 플랫 스키마 출력."
        },
        {
          "id": "step_2_data",
          "name": "data_mapping",
          "description": "scene_specs의 데이터 필드(items/values/unit/source/chartConfig) 보강. 리서치 데이터 정확히 매핑.",
          "agent": "data-mapper",
          "input": ["scene_specs.json", "research_report.json"],
          "output": ["scene_specs.json"],
          "notes": "script-director가 비워둔 데이터 필드를 리서치에서 정확히 매핑. sonnet 급 경량 에이전트."
        },
        {
          "id": "step_2b",
          "name": "fact_check",
          "description": "원고 내 주요 주장 교차 검증",
          "agent": "fact-verifier",
          "input": ["scene_specs.json", "research_report.json"],
          "output": ["factcheck_report.json"],
          "blocking": false,
          "notes": "비차단. 실패해도 파이프라인 계속. 결과는 QA 리포트에 반영."
        }
      ],
      "checkpoint": {
        "description": "원고 + 씬 연출 검토",
        "artifacts": ["scene_specs.json"]
      }
    },

    {
      "id": "stage_3",
      "name": "에셋 조립 + 렌더링",
      "description": "assembly-director 에이전트가 창의적 의도를 해석하며 TTS/이미지/매니페스트를 조립하고 렌더링",
      "execution": "agent_orchestrated",
      "steps": [
        {
          "id": "step_3a",
          "name": "image_batch",
          "description": "이미지 배치 생성/검색. FAL.ai 병렬 제출로 전체 씬 이미지를 한 번에 처리.",
          "type": "module",
          "module": "image_batch",
          "input": ["scene_specs.json", "art_style.json"],
          "output": ["images/", "characters/", "images/image_assets.json"],
          "notes": "runner가 직접 실행. assembly-director보다 먼저 실행하여 이미지를 준비."
        },
        {
          "id": "step_3b",
          "name": "assembly",
          "description": "TTS + 자막 + 이미지 검수 + 매니페스트 + 렌더링. 이미지는 이미 생성됨.",
          "agent": "assembly-director",
          "input": ["scene_specs.json", "art_style.json", "project_config", "images/"],
          "output": [
            "audio/scene_{NNN}.mp3",
            "subtitles/scene_{NNN}.srt",
            "remotion/public/manifest.json",
            "{output_video}.mp4",
            "assembly_report.json"
          ],
          "tools": [
            "tts_tool",
            "image_tool",
            "subtitle_tool",
            "manifest_tool",
            "render_tool",
            "validate_tool"
          ],
          "skills": [
            "shared/motion-presets",
            "shared/remotion-design-system",
            "shared/korean-tts-rules",
            "shared/image-generation",
            "shared/image-prompt-rules"
          ],
          "notes": "이미지는 step_3a에서 이미 생성됨. 에이전트는 TTS 생성 + 이미지 검수(실패분 재생성) + 매니페스트 + 렌더링에 집중."
        }
      ],
      "checkpoint": {
        "description": "최종 영상 + 조립 리포트 검토",
        "artifacts": ["{output_video}.mp4", "assembly_report.json"]
      }
    }
  ],

  "summary": {
    "steps": 5,
    "key_points": [
      "원고+연출 통합 → script-director 단일 에이전트",
      "scene_specs 플랫 스키마 (중첩 제거)",
      "motion preset 시스템 (15종)",
      "산출물 1개 (scene_specs.json)",
      "assembly-director가 모듈을 도구로 사용하며 에셋 조립+렌더링"
    ]
  }
}
