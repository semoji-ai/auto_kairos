{
  "$schema": "./docs/pipeline-schema.json",
  "version": "3.0",
  "description": "Auto Agent V3 파이프라인 — 에이전트/스킬 분리, Remotion-First, Simple is Best",

  "phases": [
    {
      "id": "phase_0",
      "name": "Preflight",
      "description": "환경 검증",
      "execution": "sequential",
      "steps": [
        {
          "id": "step_0",
          "name": "environment_check",
          "description": "API키, node, ffmpeg, Remotion, Lucide 의존성 검증",
          "type": "module",
          "module": "preflight",
          "checks": [
            "ANTHROPIC_API_KEY",
            "ELEVENLABS_API_KEY",
            "OPENAI_API_KEY",
            "FAL_API_KEY (conditional: source=generate인 씬 있을 때)",
            "SERPER_API_KEY (conditional: source=search인 씬 있을 때)",
            "node >= 18",
            "ffmpeg",
            "remotion CLI",
            "lucide-react installed"
          ]
        }
      ]
    },

    {
      "id": "phase_1",
      "name": "리서치 + 원고",
      "description": "심층 자료 조사 + 표준 포맷 변환 → 아웃라인 + 원고 작성",
      "execution": "sequential",
      "steps": [
        {
          "id": "step_1",
          "name": "deep_research_and_synthesis",
          "description": "deep-research-kit 실행 + research_report.json 생성",
          "agent": "research-orchestrator",
          "input": "topic (사용자 입력)",
          "output": ["RESEARCH/{topic}_{timestamp}/", "research_report.json"],
          "resumable": true,
          "skills": ["shared/research-format"],
          "notes": "내부에서 Explorer/Librarian 에이전트 병렬 배포. 리서치 완료 후 shared/research-format 규칙에 따라 research_report.json까지 직접 생성 (기존 research-synthesizer 통합)"
        },
        {
          "id": "step_2",
          "name": "outline_and_manuscript",
          "description": "3막 구조 아웃라인 설계 + 나레이션 원고 작성",
          "agent": "write-manuscript",
          "input": "research_report.json",
          "output": ["outline.json", "chapters/ch{N}.md", "final_manuscript.md"],
          "skills": ["shared/outline-template", "shared/writing-style", "shared/scene-segmentation"],
          "notes": "Phase 1: outline.json 생성 (기존 outline-builder 통합), Phase 2: narrative_draft를 핵심 재료로 원고 작성"
        }
      ]
    },

    {
      "id": "phase_2",
      "name": "분석",
      "description": "중복 감지 + 팩트 체크",
      "execution": "parallel_group_A",
      "steps": [
        {
          "id": "step_3",
          "name": "duplicate_check",
          "description": "N-gram 중복 감지",
          "module": "duplicate-checker",
          "input": "final_manuscript.md",
          "output": "duplicate_check.json",
          "blocking": false
        },
        {
          "id": "step_4",
          "name": "fact_check",
          "description": "주요 주장 교차 검증",
          "agent": "fact-verifier",
          "input": ["final_manuscript.md", "research_report.json"],
          "output": "factcheck_report.json",
          "blocking": false
        }
      ]
    },

    {
      "id": "phase_3",
      "name": "씬 설계",
      "description": "캐릭터 계획 + 씬 분할/렌더링 스펙/데이터 보강/모션 설계",
      "execution": "sequential",
      "steps": [
        {
          "id": "step_5",
          "name": "character_planning",
          "description": "원고 분석 → 2씬+ 등장 캐릭터 추출 + 변이 분석 + 캐릭터 계획 수립",
          "agent": "character-planner",
          "input": ["final_manuscript.md", "research_report.json"],
          "input_optional": ["art_style.json"],
          "output": "character_plan.json",
          "conditional": true,
          "condition": "원고에 캐릭터가 2씬+ 등장하는 경우",
          "condition_check": {"type": "file_exists", "path": "final_manuscript.md"},
          "notes": "final_manuscript.md의 ## Scene N: 구조에서 직접 인물 추출 (기존 scene_decomposition.json 입력에서 변경)"
        },
        {
          "id": "step_6",
          "name": "visual_composition_full",
          "description": "씬 분할 → 렌더링 스펙 → 데이터 보강 → 모션 설계 (4-in-1)",
          "agent": "visual-composer",
          "input": ["final_manuscript.md", "outline.json", "research_report.json"],
          "input_optional": ["character_plan.json"],
          "output": ["scene_decomposition.json", "scene_specs.json", "motion_plan.json"],
          "skills": ["shared/remotion-design-system", "shared/scene-segmentation", "shared/creative-direction", "shared/motion-rhythm", "shared/data-mapping", "shared/chart-mapping", "shared/asset-advisory"],
          "notes": "4단계 순차 실행: (1) 씬 분할→scene_decomposition.json (기존 scene-decomposer), (2) 렌더링 스펙→scene_specs.json, (3) 데이터 보강→scene_specs.json 업데이트 (기존 data-enricher), (4) 모션 설계→motion_plan.json (기존 motion-choreographer)"
        }
      ]
    },

    {
      "id": "phase_4",
      "name": "에셋 생산",
      "description": "TTS 전처리(모듈) + TTS 생성 + 이미지 에셋(선택) + 자막 동기화",
      "execution": "parallel_group_B",
      "steps": [
        {
          "id": "step_7",
          "name": "tts_preprocess",
          "description": "한국어 TTS 전처리 (Python 모듈)",
          "type": "module",
          "module": "tts-preprocess",
          "input": "scene_specs.json",
          "output": "scene_specs.json (전처리된 나레이션 텍스트)",
          "skills": ["shared/korean-tts-rules"],
          "notes": "기존 LLM 에이전트 → Python 모듈로 전환. src/tools/korean_tts_preprocessor.py 활용"
        },
        {
          "id": "step_8",
          "name": "tts_generation",
          "description": "씬별 나레이션 음성 생성",
          "module": "tts-generator",
          "input": "scene_specs.json (전처리된 텍스트)",
          "output": "output/{project}/audio/scene_{NNN}.mp3",
          "depends_on": "step_7"
        },
        {
          "id": "step_8b",
          "name": "image_asset_sourcing",
          "description": "아트스타일 기반 캐릭터 생성 + 이미지 검색/생성 + 시각화 배경",
          "module": "image-generator",
          "input": ["scene_specs.json"],
          "input_optional": ["art_style.json", "character_plan.json"],
          "output": ["output/{project}/images/", "output/{project}/characters/", "output/{project}/character_casting.json", "output/{project}/image_licenses.json"],
          "conditional": true,
          "condition": "scene_specs에 이미지 에셋이 필요한 씬이 있을 때만",
          "condition_check": {"type": "json_field_exists", "path": "scene_specs.json", "field": "scenes[].imageAsset"},
          "sub_steps": [
            "character_generation (2씬+ 등장 캐릭터, character_plan.json 기반)",
            "image_search (wikimedia/serper/pixabay 워터폴)",
            "scene_image_generation (캐릭터 참조 기반 씬 이미지)",
            "standalone_image_generation (캐릭터 없는 단발 씬)",
            "viz_background_generation (시각화 배경)"
          ],
          "notes": "캐릭터 생성→씬 생성 순서 보장. 라이선스 메타데이터 기록"
        },
        {
          "id": "step_9",
          "name": "subtitle_sync",
          "description": "WhisperX forced alignment 자막 동기화",
          "module": "subtitle-sync",
          "input": "output/{project}/audio/scene_{NNN}.mp3",
          "output": "output/{project}/subtitles/scene_{NNN}.srt",
          "depends_on": "step_8"
        },
        {
          "id": "step_9b",
          "name": "tts_verification",
          "description": "Gemini 하이브리드 TTS 발음 검증",
          "module": "tts-verifier",
          "input": ["scene_specs.json", "output/{project}/audio/"],
          "output": "output/{project}/tts_verification.json",
          "depends_on": "step_8",
          "gate": false,
          "notes": "advisory 단계. ERROR 씬은 경고하지만 파이프라인은 중단하지 않음"
        }
      ]
    },

    {
      "id": "phase_5",
      "name": "조립 + 검수",
      "description": "데이터 검증 → manifest 생성 → 사전 검수 → 영상 렌더링 → 사후 검수",
      "execution": "sequential",
      "steps": [
        {
          "id": "step_10",
          "name": "data_validation",
          "description": "전 단계 데이터 정합성 검증",
          "module": "data-validator",
          "input": ["scene_specs.json", "motion_plan.json", "output/{project}/audio/", "output/{project}/subtitles/"],
          "input_optional": ["output/{project}/images/", "output/{project}/characters/"],
          "output": "output/{project}/validation_report.json",
          "gate": true,
          "notes": "검증 실패 시 파이프라인 중단"
        },
        {
          "id": "step_11",
          "name": "manifest_building",
          "description": "Remotion manifest.json 생성",
          "module": "manifest-builder",
          "input": ["scene_specs.json", "motion_plan.json"],
          "output": "remotion/public/manifest.json",
          "notes": "scene_specs + motion_plan → Remotion SceneManifest 포맷 변환"
        },
        {
          "id": "step_11b",
          "name": "qa_pre_render",
          "description": "사전 검수 — manifest 기반 씬 스펙/아이콘/컬러/데이터 검증",
          "agent": "qa-reviewer",
          "input": ["remotion/public/manifest.json", "scene_specs.json", "research_report.json", "output/{project}/audio/", "output/{project}/subtitles/", "output/{project}/images/"],
          "output": "output/{project}/qa_report_pre.json",
          "skills": ["shared/remotion-design-system", "shared/writing-style", "shared/creative-direction", "shared/scene-segmentation", "shared/motion-rhythm", "shared/data-mapping"],
          "gate": true,
          "notes": "critical 이슈 발견 시 렌더링 차단. 공유 스킬을 검증 기준으로 참조"
        },
        {
          "id": "step_12",
          "name": "video_assembly",
          "description": "Remotion CLI로 최종 렌더링",
          "module": "video-assembler",
          "input": "remotion/public/manifest.json",
          "output": "output/{project}/final_video.mp4",
          "command": "npx remotion render {composition} --output output/{project}/final_video.mp4",
          "resolution": "1920x1080",
          "fps": 30
        },
        {
          "id": "step_12b",
          "name": "qa_post_render",
          "description": "사후 검수 — 렌더링 결과 영상 메타데이터/동기화/품질 검증",
          "agent": "qa-reviewer",
          "input": ["output/{project}/final_video.mp4", "output/{project}/qa_report_pre.json", "scene_specs.json"],
          "output": "output/{project}/qa_report_post.json",
          "notes": "블랙 프레임, 오디오 싱크, 자막 렌더링, 파일 크기 검증. 문제 발견 시 사용자 알림"
        }
      ]
    }
  ],

  "checkpoints": {
    "description": "인터랙티브 모드에서 사용자 검토 포인트",
    "points": [
      {
        "after_step": "step_2",
        "name": "원고 검토",
        "description": "outline.json + 최종 원고 확인. 수정 요청 가능"
      },
      {
        "after_step": "step_6",
        "name": "씬 설계 검토",
        "description": "Visual Composer 결과 확인 (scene_decomposition + scene_specs + motion_plan). 씬 타입/아이콘/컬러 수정 가능"
      },
      {
        "after_step": "step_8b",
        "name": "이미지 에셋 검토",
        "description": "생성/검색된 이미지 확인. 재생성 또는 대체 가능",
        "conditional": true
      },
      {
        "after_step": "step_12b",
        "name": "최종 검수 결과 검토",
        "description": "QA 사후 검수 리포트 확인. 재렌더링 또는 수정 요청 가능"
      }
    ]
  },

  "gateway": {
    "description": "에이전트 감시/복구 시스템 (Haiku 기반)",
    "enabled": true,
    "model": "claude-haiku-4-5-20251001",
    "polling_interval_sec": 2,
    "execution": "parallel_coroutine",
    "scope": "모든 LLM 서브에이전트 (phase_1 ~ phase_5)",
    "detection": {
      "timeout": "에이전트별 max_duration 초과",
      "repetition": "동일 출력 3회+ 또는 동일 도구 5회+ 연속",
      "token_explosion": "단일 턴 입력 >100K 또는 budget 초과",
      "no_progress": "마지막 출력 후 2분간 새 출력 없음",
      "error_loop": "동일 오류 3회+ 반복"
    },
    "recovery_levels": [
      {"level": 1, "action": "warning", "description": "pipeline_state.json에 warning 기록"},
      {"level": 2, "action": "restart", "description": "kill + 동일 프롬프트 재시작 (max 2회)"},
      {"level": 3, "action": "shrink_restart", "description": "입력 축소 + max_turns 50% 감소 재시도"},
      {"level": 4, "action": "skip_notify", "description": "step을 skipped_by_gateway로 표기 + 사용자 알림"}
    ],
    "agent_limits": {
      "research-orchestrator": {"max_duration_min": 20, "budget_usd": 2.5},
      "write-manuscript": {"max_duration_min": 15, "budget_usd": 2.5},
      "visual-composer": {"max_duration_min": 20, "budget_usd": 3.0},
      "character-planner": {"max_duration_min": 5, "budget_usd": 0.5},
      "fact-verifier": {"max_duration_min": 5, "budget_usd": 0.5},
      "qa-reviewer": {"max_duration_min": 5, "budget_usd": 0.5}
    }
  },

  "state_management": {
    "state_file": "pipeline_state.json",
    "resume_strategy": "step_level",
    "cost_tracking": true,
    "per_step_timing": true
  },

  "design_constraints": {
    "philosophy": "Simple is Best",
    "max_colors_per_scene": 3,
    "icon_library": "lucide-react",
    "font_primary": "Pretendard",
    "font_mono": "JetBrains Mono",
    "background_pattern_opacity_max": 0.03,
    "spring_damping_min": 150,
    "padding_min_px": 48,
    "max_info_per_scene": 1,
    "one_concept_definition": {
      "description": "하나의 씬은 아래 목록 중 정확히 하나만 담는다",
      "atomic_units": [
        "하나의 수치/통계 (예: 시장 규모 150억 달러)",
        "하나의 인물 소개 (예: 수양대군의 야망)",
        "하나의 사건 (예: 김종서 암살)",
        "하나의 비교 (예: 세조실록 vs 숙종실록)",
        "하나의 인용문 + 맥락",
        "하나의 장소/배경 묘사",
        "하나의 인과 관계 (A → B, 단 A→B→C→D는 분할)"
      ],
      "split_signals": [
        "나레이션에 '한편', '그런데', '그러나', '이어서', '한 사람이 더' 등 전환어가 등장",
        "2명 이상의 인물이 새로 소개됨",
        "시간/장소가 전환됨",
        "나레이션 글자 수가 씬 타입별 상한을 초과"
      ]
    },
    "image_asset_ratio_target": "30% 이하",
    "notes": "아이콘+타이포+차트가 기본. 이미지 에셋은 정보 전달 극대화를 위한 전략적 배치"
  }
}
